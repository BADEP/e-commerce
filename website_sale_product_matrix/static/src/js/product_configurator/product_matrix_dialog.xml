<templates xml:space="preserve">
    <t t-name="website_sale_product_matrix.ProductMatrixDialog">
        <Dialog
            size="'xl'"
            contentClass="'o_wsale_product_matrix_dialog'"
            title.translate="Configure product options"
        >
            <div
                t-ref="this.matrixRef"
                t-on-click="this.onClickQuantityButton"
                t-on-change="this.onChangeQuantity"
                t-out="this.matrixHtml"
            />
            <t t-set-slot="footer">
                <button
                    name="website_sale_product_matrix_confirm_button"
                    class="btn btn-primary"
                    t-on-click="this.onConfirm"
                >
                    Confirm
                </button>
                <button class="btn btn-light" t-on-click="() => this.props.close()">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>
</templates>
