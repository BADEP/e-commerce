<data>
    <template id="alt_price" name="Alternative taxes">
        <p class="text-muted small">
            <t t-if="alt_price != price">
                <span
                    class="js_alt_price"
                    t-out="alt_price"
                    t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"
                />
                <del
                    t-attf-class="js_alt_list_price mr8 text-muted text-nowrap #{ '' if has_discounted_price else 'd-none' }"
                    t-out="alt_list_price"
                    t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"
                />
                <span t-if="alt_field == 'total_included'">with taxes</span>
                <span t-if="alt_field == 'total_excluded'">without taxes</span>
            </t>
        </p>
    </template>
    <template
        id="products_item"
        name="Alternative (un)taxed price"
        inherit_id="website_sale.products_item"
    >
        <xpath expr="//*[hasclass('product_price')]">
            <t t-call="website_sale_b2x_alt_price.alt_price"
                price="template_price_vals['price_reduce']"
                alt_price="template_price_vals['alt_price']"
                alt_list_price="template_price_vals['alt_list_price']"
                has_discounted_price="template_price_vals['has_discounted_price']"
                alt_field="template_price_vals['alt_field']"/>
        </xpath>
    </template>
    <template
        id="product_price"
        name="Alternative (un)taxed price"
        inherit_id="website_sale.product_price"
    >
        <xpath expr="//div[@name='product_price']" position="after">
            <t t-call="website_sale_b2x_alt_price.alt_price"
                price="combination_info['price']"
                alt_price="combination_info['alt_price']"
                alt_list_price="combination_info['alt_list_price']"
                has_discounted_price="combination_info['has_discounted_price']"
                alt_field="combination_info['alt_field']"/>
        </xpath>
    </template>
    <template
        id="sale_order_portal_template"
        inherit_id="sale.sale_order_portal_template"
    >
        <xpath expr="//t[@t-set='title']/h2" position="attributes">
            <attribute name="t-field" />
            <attribute name="t-out">(
                sale_order.amount_total
                if env.website.show_line_subtotals_tax_selection == 'tax_included'
                else sale_order.amount_untaxed
            )</attribute>
            <attribute
                name="t-options"
            >{'widget': 'monetary', 'display_currency': sale_order.currency_id}</attribute>
            <attribute name="t-att-data-id">(
                'total_amount'
                if env.website.show_line_subtotals_tax_selection == 'tax_included'
                else 'untaxed_amount'
            )</attribute>
        </xpath>
        <xpath expr="//t[@t-set='title']/h2" position="after">
            <t
                t-if="env.website.show_line_subtotals_tax_selection == 'tax_included'"
            >
                <span class="text-nowrap">
                    <span
                        id="b2c_alt_amount"
                        t-field="sale_order.amount_untaxed"
                        data-id="untaxed_amount"
                    />
                    <small> (without taxes)</small>
                </span>
            </t>
            <t t-else="">
                <span class="text-nowrap">
                    <span
                        id="b2b_alt_amount"
                        t-field="sale_order.amount_total"
                        data-id="total_amount"
                    />
                    <small> (with taxes)</small>
                </span>
            </t>
        </xpath>
        <!-- Odoo 20 labels the sidebar total "Tax Included"; keep it accurate
             when the untaxed amount is the main one. -->
        <xpath expr="//t[@t-set='subtitle']" position="attributes">
            <attribute
                name="t-if"
            >env.website.show_line_subtotals_tax_selection == 'tax_included'</attribute>
        </xpath>
        <xpath expr="//t[@t-set='subtitle']" position="after">
            <t t-else="" t-set="subtitle">Tax Excluded</t>
        </xpath>
    </template>
</data>
