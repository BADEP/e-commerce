<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="website_sale_variants_hide_no_variant_attributes"
        inherit_id="website_sale.variants"
        name="Variant selector: hide non-variant-defining attributes"
    >
        <xpath expr="//ul[@t-att-data-attribute-exclusions]" position="attributes">
            <attribute
                name="t-attf-class"
            >o_wsale_product_page_variants d-flex flex-column gap-4 list-unstyled js_add_cart_variants #{ul_class} #{'d-none' if not product.valid_product_template_attribute_line_ids._without_no_variant_attributes() else '' }</attribute>
        </xpath>
        <xpath
            expr="//t[@t-foreach='product.valid_product_template_attribute_line_ids']"
            position="attributes"
        >
            <attribute
                name="t-foreach"
            >product.valid_product_template_attribute_line_ids._without_no_variant_attributes()</attribute>
        </xpath>
    </template>
</odoo>
